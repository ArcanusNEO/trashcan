+                    "class|const|consteval|constexpr|constinit|enum|explicit|"
+                    "decltype|extern|friend|inline|mutable|register|restrict|static|"
+                    "struct|template|thread_local|typedef|typename|union|"
+                    "using|virtual|volatile",
