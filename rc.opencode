#!/bin/sh

. /etc/profile
export USER="$(whoami)"
USER_LOGIN_SHELL="$(getent passwd $USER | cut -d: -f7)"
USER_LOGIN_SHELL_NAME="$(basename $USER_LOGIN_SHELL)"
if [ -r ~/."${USER_LOGIN_SHELL_NAME}"rc ]; then
  . ~/."${USER_LOGIN_SHELL_NAME}"rc
fi

OPENCODE="$(command -v opencode)"

opencode_start() {
  if [ -x "$OPENCODE" ]; then
    echo "Starting OpenCode server daemon..."
    /usr/bin/daemon -r -P ~/.run -n opencode -- "$OPENCODE" serve --hostname 10.48.59.6 >/dev/null 2>&1
  fi
}

opencode_stop() {
  echo "Stopping OpenCode server..."
  /usr/bin/daemon -r -P ~/.run -n opencode --stop
}

opencode_restart() {
  /usr/bin/daemon -r -P ~/.run -n opencode --restart
}

case "$1" in
  'start')
    opencode_start
    ;;
  'stop')
    opencode_stop
    ;;
  'restart')
    opencode_restart
    ;;
  *)
    echo "usage $0 start|stop|restart"
esac
