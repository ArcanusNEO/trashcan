#!/bin/sh

. /etc/profile
export USER="$(whoami)"
USER_LOGIN_SHELL="$(getent passwd $USER | cut -d: -f7)"
USER_LOGIN_SHELL_NAME="$(basename $USER_LOGIN_SHELL)"
if [ -r ~/."${USER_LOGIN_SHELL_NAME}"rc ]; then
  . ~/."${USER_LOGIN_SHELL_NAME}"rc
fi

OPENCODE="$(command -v opencode)"

opencode_start() {
  if [ -x "$OPENCODE" ]; then
    WGIP="$(/sbin/ip -4 -o addr show dev wg0 2>/dev/null | /usr/bin/awk '{split($4, addr, "/"); print addr[1]; exit}')"
    if [ -z "$WGIP" ]; then
      echo "WireGuard interface not configured, aborting OpenCode server daemon startup." >&2
      return 1
    fi
    echo "Starting OpenCode server daemon..."
    /usr/bin/daemon -r -P ~/.run -n opencode -- "$OPENCODE" serve --hostname "$WGIP" >/dev/null 2>&1
  fi
}

opencode_stop() {
  echo "Stopping OpenCode server..."
  /usr/bin/daemon -r -P ~/.run -n opencode --stop
}

opencode_restart() {
  /usr/bin/daemon -r -P ~/.run -n opencode --restart
}

case "$1" in
  'start')
    opencode_start
    ;;
  'stop')
    opencode_stop
    ;;
  'restart')
    opencode_restart
    ;;
  *)
    echo "usage $0 start|stop|restart"
esac
