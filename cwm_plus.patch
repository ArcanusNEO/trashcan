 	cc->geom.x = area.x;
@@ -1007,9 +1030,11 @@ client_vtile(struct client_ctx *cc)
 	if (n == 0)
 		return;
 
+	if (cc->flags & CLIENT_FULLSCREEN)
+		return;
 	if (cc->flags & CLIENT_HMAXIMIZED ||
 	    cc->geom.w + (cc->bwidth * 2) >= area.w)
-		return;
+		cc->bwidth = Conf.bwidth;
 
 	cc->flags &= ~CLIENT_VMAXIMIZED;
 	cc->geom.x = area.x;
