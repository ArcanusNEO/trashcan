{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",
  "disabled_providers": [],
  "provider": {
    "packyapi": {
      "name": "packyapi",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://cf.api.fan/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 1024000,
            "input": 768000,
            "output": 32000
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 1024000,
            "input": 768000,
            "output": 32000
          }
        },
        "claude-opus-5": {
          "name": "claude-opus-5",
          "limit": {
            "context": 1024000,
            "input": 768000,
            "output": 32000
          }
        }
      }
    }
  }
}
