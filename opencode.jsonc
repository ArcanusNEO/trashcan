{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",
  "permission": "allow",
  "disabled_providers": [],
  "provider": {
    "packyapi": {
      "name": "packyapi",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://slb-v1.api.fan/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "deepseek-flash",
          "limit": {
            "context": 1000000,
            "input": 960000,
            "output": 32000
          }
        },
        "claude-opus-5-5": {
          "name": "claude-opus-5-5",
          "limit": {
            "context": 1000000,
            "input": 960000,
            "output": 32000
          }
        }
      }
    }
  },
  "mcp": {
    "database-manager": {
      "type": "remote",
      "url": "https://sre-db-manager.internal.unity.cn/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer mcp_"
      }
    }
  }
}
