{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",
  "permission": "allow",
  "disabled_providers": [],
  "provider": {
    "packyapi": {
      "name": "packyapi",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://slb-v1.api.fan/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "deepseek-flash",
          "limit": {
            "context": 1000000,
            "input": 768000,
            "output": 32000
          }
        },
        "claude-opus-5-5": {
          "name": "claude-opus-5-5",
          "limit": {
            "context": 192000,
            "input": 168000,
            "output": 8000
          }
        }
      }
    }
  }
}
