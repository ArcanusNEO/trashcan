{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode-go",
      "effect": "deny"
    }
  ],
  "providers": {
    "packyapi": {
      "name": "packyapi",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://slb-v1.api.fan/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "deepseek-flash",
          "limit": {
            "context": 1000000,
            "input": 960000,
            "output": 32000
          }
        },
        "claude-opus-5-5": {
          "name": "claude-opus-5-5",
          "limit": {
            "context": 1000000,
            "input": 960000,
            "output": 32000
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "database-manager": {
        "type": "remote",
        "url": "https://sre-db-manager.internal.unity.cn/api/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer mcp_"
        }
      }
    }
  }
}
